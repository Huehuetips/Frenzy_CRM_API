generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  nuevo
  contactado
  calificado
  perdido
  convertido
}

enum LeadActivityType {
  note
  status_change
  webhook
}

model User {
  idUser           String   @id @default(uuid())
  emailUser        String   @unique
  passwordHashUser String
  createdAtUser    DateTime @default(now())
  updatedAtUser    DateTime @updatedAt

  @@map("users")
}

model Lead {
  idLead        String         @id @default(uuid())
  nameLead      String
  emailLead     String
  phoneLead     String?
  sourceLead    String?
  statusLead    LeadStatus     @default(nuevo)
  activities    LeadActivity[]
  createdAtLead DateTime       @default(now())
  updatedAtLead DateTime       @updatedAt

  @@index([emailLead])
  @@index([statusLead])
  @@index([sourceLead])
  @@index([createdAtLead])
  @@map("leads")
}

model LeadActivity {
  idLeadActivity        String           @id @default(uuid())
  leadId                String
  lead                  Lead             @relation(fields: [leadId], references: [idLead], onDelete: Cascade)
  typeLeadActivity      LeadActivityType @default(note)
  noteLeadActivity      String
  createdAtLeadActivity DateTime         @default(now())

  @@index([leadId])
  @@index([createdAtLeadActivity])
  @@map("lead_activities")
}
