NODE_ENV=development
PORT=3000

# DATABASE_URL: Do NOT set this when using Docker Compose.
# Prisma reads this file directly inside the container and localhost:5432 refers
# to the container itself, not the postgres service. Docker Compose handles the
# internal connection automatically via its environment defaults.
# Only set this when running tests from the host:
# DATABASE_URL="postgresql://frenzy_crm:frenzy_crm_password@localhost:5433/frenzy_crm?schema=public"

JWT_SECRET="change_me_min_16_chars"
JWT_EXPIRES_IN="1d"
WEBHOOK_SECRET="change_me_webhook"
